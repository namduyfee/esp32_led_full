# -----------------------------------------------------------------------------
# OneDrive + TortoiseGit safety
# -----------------------------------------------------------------------------
# OneDrive conflict/temporary files. These files must not be committed.
*.temp
*.partial
*.crdownload
*.download
*.uploading
*.tmp.drivedownload
*.tmp.driveupload
*.icloud
*.url

# OneDrive conflict copies commonly generated during sync conflicts.
* - Copy.*
* - copy.*
* (Conflicted copy*).*
* (conflicted copy*).*
* (Conflict*).*
* (conflict*).*
* (Autosaved*).*
* (autosaved*).*
* (Recovered*).*
* (recovered*).*
*~RF*

# TortoiseGit / Git merge temporary files.
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*
*.rej

# Local Git backup archives created after commit.
# Recommended file names: repo_git_backup_YYYYMMDD_HHMMSS.zip or .git_YYYYMMDD.zip
repo_git_backup_*.zip
.git_*.zip
git_backup_*.zip
GitBackup/
GitBackups/

# Do not commit local backup/export folders.
_backup/
backup/
backups/
*.7z
*.rar

# -----------------------------------------------------------------------------
# Keep source assets that are part of the app/firmware UI.
# The broad image ignore rules above are for photos/media dumps; these exceptions
# allow intentional project resources to be versioned.
# -----------------------------------------------------------------------------
!**/Resources/Images/**
!**/Resources/AppIcon/**
!**/Resources/Splash/**
!**/Assets/**
!**/assets/**
!**/wwwroot/**
